---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg class:list={['picto', className]} viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linejoin="miter">
  {name === 'diseno' && (<><circle cx="24" cy="38" r="16" /><path d="M38 8 56 40H20Z" /></>)}
  {name === 'desarrollo' && (<path d="M22 14 6 32l16 18M42 14l16 18-16 18M37 8 27 56" />)}
  {name === 'productividad' && (<><rect x="10" y="8" width="44" height="48" /><path d="M10 24h44M10 40h44M32 8v48" /></>)}
  {name === 'privacidad' && (<><circle cx="20" cy="32" r="13" /><path d="M33 32h25M46 32v11M56 32v8" /></>)}
  {name === 'colaboracion' && (<><circle cx="32" cy="22" r="14" /><circle cx="22" cy="42" r="14" /><circle cx="42" cy="42" r="14" /></>)}
  {name === 'educacion' && (<path d="M32 16C24 9 14 9 6 11v40c8-2 18-2 26 5 8-7 18-7 26-5V11c-8-2-18-2-26 5ZM32 16v40" />)}
  {name === 'universidad' && (<path d="M32 6 6 24h52ZM10 56h44M6 24v0M15 24v32M26 24v32M38 24v32M49 24v32" />)}
  {name === 'cambio' && (<path d="M6 22h46M40 10l12 12-12 12M58 42H12M24 30 12 42l12 12" />)}
</svg>
